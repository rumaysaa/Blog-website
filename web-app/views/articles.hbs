<div class="container-fluid homepage">

    {{#if session.user}}
    {{#if data.recommendations}}
    <section class="for-you-section" id="forYouSection">
        <div class="homepage-header">
            <div class="header-left">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-heart" style="color: var(--accent-color); margin-right: 0.5rem;"></i>For You
                        <span class="section-subtitle-dark">Personalized recommendations based on your interests</span>
                    </h2>
                </div>
            </div>
            <div class="header-right">
                <div class="search-bar-container" id="searchContainer">
                    <i class="fas fa-search search-icon-header"></i>
                    <input type="text" id="searchInput" class="search-bar-header" placeholder="Search articles...">
                </div>
            </div>
        </div>
        <div class="articles-grid" id="forYouGrid">
            {{#each data.recommendations}}
            <a href="/comments?id={{_id}}" class="article-card carousel-item" data-title="{{heading}}"
                data-category="{{#if categoryID}}{{categoryID.catName}}{{/if}}"
                style="text-decoration: none; color: inherit;">
                <div class="article-card-image">
                    {{#if coverPhoto}}
                    <img src="/uploads/{{coverPhoto}}" alt="{{heading}}"
                        style="width: 100%; height: 100%; object-fit: cover;">
                    {{else}}
                    <i class="fas fa-image"></i>
                    {{/if}}
                </div>
                <div class="article-card-body">
                    <div class="card-top-meta">
                        {{#if categoryID}}
                        <span class="article-category">{{categoryID.catName}}</span>
                        {{else}}
                        <span class="article-category">Uncategorized</span>
                        {{/if}}
                    </div>
                    <h5 class="article-card-title">{{heading}}</h5>
                    {{#if description}}
                    <div class="article-preview">
                        {{#truncate description 100}}{{/truncate}}
                    </div>
                    {{/if}}
                    <div class="card-author-date">
                        <span class="author-info">
                            <i class="fas fa-user" style="font-size: 0.75rem; margin-right: 0.25rem;"></i>
                            {{#if userID}}{{userID.name}}{{else}}Anonymous{{/if}}
                        </span>
                        <span class="author-date" style="color: #95a5a6; font-size: 0.8rem;">
                            <i class="fas fa-calendar-alt" style="font-size: 0.7rem; margin-right: 0.25rem;"></i>
                            {{#formatDate createdAt}}{{/formatDate}}
                        </span>
                    </div>
                    <div class="article-card-footer">
                        <div class="article-stats-full">
                            <span class="stat-item-full">
                                <i class="fas fa-heart" style="color: var(--accent-color);"></i>
                                <span>{{likes}}</span>
                            </span>
                            <span class="stat-item-full">
                                <i class="fas fa-comment"></i>
                                <span>{{commentCount}}</span>
                            </span>
                            <span class="stat-item-full">
                                <i class="fas fa-bookmark"></i>
                                <span>{{bookmarkCount}}</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
            {{/each}}
        </div>
    </section>
    {{/if}}
    {{/if}}

    <section class="discover-section" id="discoverSection">
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-fire" style="color: var(--secondary-color); margin-right: 0.5rem;"></i>Discover
                <span class="section-subtitle-dark">Latest articles from our community</span>
            </h2>
        </div>
        {{#if data.recentArticles}}
        <div class="articles-grid" id="articlesContainer">
            {{#each data.recentArticles}}
            <a href="/comments?id={{_id}}" class="article-card carousel-item" data-title="{{heading}}"
                data-category="{{#if categoryID}}{{categoryID.catName}}{{/if}}"
                style="text-decoration: none; color: inherit;">
                <div class="article-card-image">
                    {{#if coverPhoto}}
                    <img src="/uploads/{{coverPhoto}}" alt="{{heading}}"
                        style="width: 100%; height: 100%; object-fit: cover;">
                    {{else}}
                    <i class="fas fa-image"></i>
                    {{/if}}
                </div>
                <div class="article-card-body">
                    <div class="card-top-meta">
                        <span class="article-category">{{#if
                            categoryID}}{{categoryID.catName}}{{else}}Uncategorized{{/if}}</span>
                    </div>
                    <h5 class="article-card-title">{{heading}}</h5>
                    {{#if description}}
                    <div class="article-preview">
                        {{#truncate description 100}}{{/truncate}}
                    </div>
                    {{/if}}
                    <div class="card-author-date">
                        <span class="author-info">
                            <i class="fas fa-user" style="font-size: 0.75rem; margin-right: 0.25rem;"></i>
                            {{#if userID}}{{userID.name}}{{else}}Anonymous{{/if}}
                        </span>
                        <span class="author-date" style="color: #95a5a6; font-size: 0.8rem;">
                            <i class="fas fa-calendar-alt" style="font-size: 0.7rem; margin-right: 0.25rem;"></i>
                            {{#formatDate createdAt}}{{/formatDate}}
                        </span>
                    </div>
                    <div class="article-card-footer">
                        <div class="article-stats-full">
                            <span class="stat-item-full">
                                <i class="fas fa-heart" style="color: var(--accent-color);"></i>
                                <span>{{likes}}</span>
                            </span>
                            <span class="stat-item-full">
                                <i class="fas fa-comment"></i>
                                <span>{{commentCount}}</span>
                            </span>
                            <span class="stat-item-full">
                                <i class="fas fa-bookmark"></i>
                                <span>{{bookmarkCount}}</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
            {{/each}}
        </div>

        {{#if data.recentArticles.length}}
        <div class="show-more-container">
            <button id="showMoreBtn" class="show-more-btn">
                <i class="fas fa-plus" style="margin-right: 0.5rem;"></i>Show More
            </button>
        </div>
        {{/if}}
        {{else}}
        <div class="alert alert-info text-center">
            <h5><i class="fas fa-lightbulb"></i> Start Exploring</h5>
            <p>Be the first to write an article!</p>
            <a href="/articles/form" class="btn btn-primary">Write Article</a>
        </div>
        {{/if}}
    </section>
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    const showMoreBtn = document.getElementById('showMoreBtn');
    const articlesGrid = document.getElementById('articlesContainer');

    let isLoadingMore = false;

    function handleSearch(e) {
        if (e.key === 'Enter') {
            const query = searchInput.value.trim();
            if (query) {
                window.location.href = '/articles/search?q=' + encodeURIComponent(query);
            }
        }
    }

    if (searchInput) {
        searchInput.addEventListener('keypress', handleSearch);
    }

    function calculateItemsPerRow() {
        if (!articlesGrid) return 3;
        const gridStyle = window.getComputedStyle(articlesGrid);
        const columns = gridStyle.gridTemplateColumns.split(' ').length;
        return columns;
    }

    function updateShowMoreButton() {
        if (!showMoreBtn || !articlesGrid) return;

        const items = articlesGrid.querySelectorAll('.article-card');
        const visibleItems = Array.from(items).filter(item => window.getComputedStyle(item).display !== 'none');
        const itemsPerRow = calculateItemsPerRow();
        const minItemsForShowMore = itemsPerRow * 2 + 1;

        if (visibleItems.length > minItemsForShowMore) {
            showMoreBtn.style.display = 'block';
        } else {
            showMoreBtn.style.display = 'none';
        }
    }

    if (showMoreBtn) {
        showMoreBtn.addEventListener('click', function () {
            if (isLoadingMore) return;
            isLoadingMore = true;

            const items = articlesGrid.querySelectorAll('.article-card');
            const hiddenItems = Array.from(items).filter(item => window.getComputedStyle(item).display === 'none');

            if (hiddenItems.length === 0) {
                showMoreBtn.style.display = 'none';
                isLoadingMore = false;
                return;
            }

            const itemsToShow = Math.min(6, hiddenItems.length);

            for (let i = 0; i < itemsToShow; i++) {
                hiddenItems[i].style.opacity = '0';
                hiddenItems[i].style.display = '';
                setTimeout(() => {
                    hiddenItems[i].style.transition = 'opacity 0.4s ease-in-out';
                    hiddenItems[i].style.opacity = '1';
                }, 10 + (i * 50));
            }

            setTimeout(() => {
                updateShowMoreButton();
                isLoadingMore = false;
            }, 500);
        });
    }

    window.addEventListener('load', () => {
        updateShowMoreButton();
    });
    window.addEventListener('resize', () => {
        updateShowMoreButton();
    });
</script>