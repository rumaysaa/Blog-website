<div class="article-editor-page">
    {{#if @root.query.msg}}
    <div class="alert alert-danger" style="margin-bottom: 2rem; padding: 1rem; border-radius: 6px; border-left: 4px solid #e74c3c;">
        <i class="fas fa-exclamation-circle" style="margin-right: 0.5rem;"></i>{{@root.query.msg}}
    </div>
    {{/if}}

    <div class="editor-header">
        <h1>
            {{#if data.art._id}}
            <i class="fas fa-edit" style="margin-right: 0.8rem;"></i>Edit Article
            {{else}}
            <i class="fas fa-pen-fancy" style="margin-right: 0.8rem;"></i>Write New Article
            {{/if}}
        </h1>
        <p class="editor-subtitle">Share your thoughts with the world</p>
    </div>

    <form action="/articles/add?id={{data.art._id}}" method="POST" enctype="multipart/form-data" class="editor-form">
        <input type="hidden" name="userID" value="{{session.user._id}}">
        <input type="hidden" id="_id" value="{{data.art._id}}" name="articleID">

        <div class="editor-container">
            <!-- Left Sidebar -->
            <div class="editor-sidebar">
                <div class="sidebar-section">
                    <h3 class="sidebar-title">
                        <i class="fas fa-cog" style="margin-right: 0.5rem;"></i>Article Settings
                    </h3>

                    <div class="sidebar-form-group">
                        <label class="sidebar-label">
                            <i class="fas fa-folder" style="margin-right: 0.4rem;"></i>Category
                        </label>
                        <select 
                            id="categorySelect"
                            name="categoryID" 
                            value="{{data.art.categoryID}}"
                            class="sidebar-select">
                            <option value="">Select category...</option>
                            {{#each data.cats}}
                            <option value="{{_id}}" {{#selected @root.data.art.categoryID _id}} {{/selected}}>
                                {{catName}}
                            </option>
                            {{/each}}
                        </select>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="openAddCategoryBtn" style="margin-top: 0.5rem; width: 100%; text-align: center;">
                            <i class="fas fa-plus"></i> New Category
                        </button>
                    </div>

                    <div class="sidebar-form-group">
                        <label class="sidebar-label">
                            <i class="fas fa-image" style="margin-right: 0.4rem;"></i>Cover Photo
                        </label>
                        <div class="cover-photo-upload">
                            <input 
                                type="file" 
                                id="coverPhoto" 
                                name="coverPhoto" 
                                accept="image/*"
                                class="cover-photo-input">
                            <label for="coverPhoto" class="cover-photo-label">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <span>Click to upload</span>
                            </label>
                        </div>
                        <small style="color: #7f8c8d; display: block; margin-top: 0.5rem;">
                            JPG, PNG, GIF (Max 5MB)
                        </small>
                        <div id="fileError" style="color: #e74c3c; font-size: 0.85rem; margin-top: 0.5rem; display: none;">
                            <i class="fas fa-times-circle" style="margin-right: 0.3rem;"></i><span id="errorMsg"></span>
                        </div>
                        <div id="fileSuccess" style="color: #27ae60; font-size: 0.85rem; margin-top: 0.5rem; display: none;">
                            <i class="fas fa-check-circle" style="margin-right: 0.3rem;"></i><span id="successMsg"></span>
                        </div>
                    </div>

                    <div class="sidebar-form-group">
                        <label class="sidebar-label">
                            <i class="fas fa-heading" style="margin-right: 0.4rem;"></i>Title
                        </label>
                        <input 
                            type="text" 
                            id="heading" 
                            name="heading" 
                            value="{{data.art.heading}}"
                            placeholder="Article title"
                            class="sidebar-input"
                            required>
                        <small style="color: #7f8c8d; display: block; margin-top: 0.3rem;">
                            Be descriptive and engaging
                        </small>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="editor-main">
                <div class="content-section">
                    <label class="content-label">
                        <i class="fas fa-align-left" style="margin-right: 0.5rem;"></i>Article Content
                    </label>
                    <textarea 
                        id="description" 
                        name="description" 
                        placeholder="Write your amazing article here... Share your insights, ideas, and stories with the community."
                        class="content-textarea"
                        required>{{data.art.description}}</textarea>
                </div>

                <!-- Tags Section -->
                <div class="tags-section">
                    <h3 class="tags-title">
                        <i class="fas fa-tags" style="margin-right: 0.5rem;"></i>Article Tags
                    </h3>
                    <p class="tags-hint">Add relevant keywords to help readers discover your article</p>
                    
                    <div class="tags-input-area">
                        <input 
                            type="text" 
                            id="tagInput" 
                            class="tag-input" 
                            placeholder="Type a tag and press Enter">
                        <button type="button" class="btn btn-sm btn-secondary" id="addTagBtn">
                            <i class="fas fa-plus" style="margin-right: 0.3rem;"></i>Add
                        </button>
                    </div>

                    <div id="tagsDisplay" class="tags-display">
                    </div>
                    <input type="hidden" id="tagsInput" name="tags" value="">
                </div>

                <!-- Action Buttons -->
                <div class="editor-actions">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save" style="margin-right: 0.5rem;"></i>{{#if data.art._id}}Update Article{{else}}Publish Article{{/if}}
                    </button>
                    <a href="/articles" class="btn btn-cancel btn-lg">
                        <i class="fas fa-times" style="margin-right: 0.5rem;"></i>Cancel
                    </a>
                </div>
            </div>
        </div>
    </form>

    <!-- Add Category Modal -->
    <div id="addCategoryModal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">
                    <i class="fas fa-folder-plus" style="margin-right: 0.5rem;"></i>Add New Category
                </h2>
                <button type="button" class="modal-close" id="closeModalBtn">×</button>
            </div>
            <div class="modal-body">
                <div class="modal-form-group">
                    <label class="modal-label">Category Name</label>
                    <input 
                        type="text" 
                        id="newCategoryInput" 
                        class="modal-input" 
                        placeholder="e.g., Technology, Travel, Food..."
                        autocomplete="off">
                    <small class="modal-hint">Choose a unique, descriptive name for your category</small>
                </div>
                <div id="categoryError" class="modal-error" style="display: none;">
                    <i class="fas fa-exclamation-circle" style="margin-right: 0.3rem;"></i><span id="errorText"></span>
                </div>
                <div id="categorySuccess" class="modal-success" style="display: none;">
                    <i class="fas fa-check-circle" style="margin-right: 0.3rem;"></i><span id="successText"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelModalBtn">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitCategoryBtn">
                    <i class="fas fa-plus" style="margin-right: 0.3rem;"></i>Add Category
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.article-editor-page {
    padding: 2rem 1rem;
    max-width: 1400px;
    margin: 80px auto 0;
    min-height: 100vh;
}

.editor-header {
    margin-bottom: 3rem;
    text-align: center;
}

.editor-header h1 {
    font-size: 2.5rem;
    color: var(--primary-color);
    font-weight: 700;
    margin: 0 0 0.5rem 0;
}

.editor-subtitle {
    color: #7f8c8d;
    font-size: 1.1rem;
    margin: 0;
}

.editor-form {
    display: contents;
}

.editor-container {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 3rem;
    min-height: calc(100vh - 300px);
}

.editor-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 100px;
    height: fit-content;
    max-height: calc(100vh - 150px);
    overflow-y: auto;
}

.sidebar-section {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #ecf0f1;
}

.sidebar-title {
    font-size: 1.1rem;
    color: var(--primary-color);
    font-weight: 700;
    margin: 0 0 1.5rem 0;
    padding-bottom: 1rem;
    border-bottom: 2px solid #ecf0f1;
}

.sidebar-form-group {
    margin-bottom: 1.5rem;
}

.sidebar-form-group:last-child {
    margin-bottom: 0;
}

.sidebar-label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
}

.sidebar-input,
.sidebar-select {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid #d5d8dc;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: border-color 0.3s ease;
}

.sidebar-input:focus,
.sidebar-select:focus {
    outline: none;
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.cover-photo-upload {
    position: relative;
    margin-bottom: 0.5rem;
}

.cover-photo-input {
    display: none;
}

.cover-photo-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem 0.5rem;
    border: 2px dashed var(--secondary-color);
    border-radius: 8px;
    background-color: rgba(52, 152, 219, 0.05);
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.9rem;
    color: var(--secondary-color);
    font-weight: 500;
}

.cover-photo-label:hover {
    background-color: rgba(52, 152, 219, 0.1);
    border-color: #2980b9;
}

.cover-photo-label i {
    font-size: 1.8rem;
}

.editor-main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.content-section {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #ecf0f1;
    flex: 1;
}

.content-label {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--primary-color);
    margin-bottom: 1rem;
}

.content-textarea {
    width: 100%;
    height: 500px;
    padding: 1.5rem;
    border: 2px solid #ecf0f1;
    border-radius: 8px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    resize: vertical;
    transition: border-color 0.3s ease;
}

.content-textarea:focus {
    outline: none;
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.content-textarea::placeholder {
    color: #bdc3c7;
}

.tags-section {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #ecf0f1;
}

.tags-title {
    font-size: 1rem;
    color: var(--primary-color);
    font-weight: 700;
    margin: 0 0 0.3rem 0;
}

.tags-hint {
    color: #7f8c8d;
    font-size: 0.85rem;
    margin: 0 0 1rem 0;
}

.tags-input-area {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1rem;
}

.tag-input {
    flex: 1;
    padding: 0.5rem;
    border: 1px solid #d5d8dc;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: border-color 0.3s ease;
}

.tag-input:focus {
    outline: none;
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.tags-display {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}

.tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--secondary-color);
    color: white;
    padding: 0.4rem 0.7rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
}

.remove-tag {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    font-size: 1rem;
    padding: 0;
    margin-left: 0.3rem;
    display: flex;
    align-items: center;
    line-height: 1;
}

.remove-tag:hover {
    opacity: 0.8;
}

.editor-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    padding-top: 2rem;
    border-top: 2px solid #ecf0f1;
}

.btn-lg {
    padding: 0.8rem 2.5rem !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
}

@media (max-width: 1024px) {
    .editor-container {
        grid-template-columns: 340px 1fr;
        gap: 2rem;
    }

    .editor-sidebar {
        position: static;
        max-height: none;
    }

    .content-textarea {
        height: 400px;
    }
}

@media (max-width: 768px) {
    .article-editor-page {
        padding: 1.5rem 0.75rem;
    }

    .editor-header h1 {
        font-size: 1.8rem;
    }

    .editor-container {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .editor-sidebar {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .content-textarea {
        height: 350px;
    }

    .editor-actions {
        flex-direction: column;
    }

    .btn-lg {
        width: 100%;
    }
}

@media (max-width: 576px) {
    .article-editor-page {
        padding: 1rem 0.5rem;
    }

    .editor-sidebar {
        grid-template-columns: 1fr;
    }

    .sidebar-section {
        padding: 1rem;
    }

    .content-section {
        padding: 1rem;
    }

    .tags-section {
        padding: 1rem;
    }

    .content-textarea {
        height: 300px;
        font-size: 0.95rem;
    }

    .tags-input-area {
        flex-direction: column;
    }

    .btn-lg {
        padding: 0.7rem 1.5rem !important;
        font-size: 0.95rem !important;
    }

    .modal-content {
        width: 95% !important;
    }
}

.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-content {
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    width: 100%;
    max-width: 450px;
    animation: slideIn 0.3s ease;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-50px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem;
    border-bottom: 1px solid #ecf0f1;
}

.modal-title {
    font-size: 1.3rem;
    color: var(--primary-color);
    font-weight: 700;
    margin: 0;
}

.modal-close {
    background: none;
    border: none;
    font-size: 1.8rem;
    color: #7f8c8d;
    cursor: pointer;
    padding: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s ease;
}

.modal-close:hover {
    color: var(--primary-color);
}

.modal-body {
    padding: 2rem;
}

.modal-form-group {
    margin-bottom: 1.5rem;
}

.modal-label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
}

.modal-input {
    width: 100%;
    padding: 0.8rem;
    border: 2px solid #ecf0f1;
    border-radius: 8px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
}

.modal-input:focus {
    outline: none;
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.modal-hint {
    display: block;
    color: #7f8c8d;
    font-size: 0.85rem;
    margin-top: 0.5rem;
}

.modal-error {
    padding: 1rem;
    background-color: #fadbd8;
    color: #c0392b;
    border-radius: 8px;
    border-left: 4px solid #c0392b;
    margin-bottom: 1rem;
    font-size: 0.9rem;
}

.modal-success {
    padding: 1rem;
    background-color: #d5f4e6;
    color: #27ae60;
    border-radius: 8px;
    border-left: 4px solid #27ae60;
    margin-bottom: 1rem;
    font-size: 0.9rem;
}

.modal-footer {
    display: flex;
    gap: 1rem;
    padding: 1.5rem 2rem;
    border-top: 1px solid #ecf0f1;
    justify-content: flex-end;
}

.modal-footer .btn {
    padding: 0.6rem 1.5rem !important;
}
</style>

<script>
let tags = [];

function renderTags() {
    const tagsDisplay = document.getElementById('tagsDisplay');
    const tagsInput = document.getElementById('tagsInput');
    tagsDisplay.innerHTML = '';
    
    tags.forEach((tag, index) => {
        const tagEl = document.createElement('span');
        tagEl.className = 'tag-badge';
        tagEl.innerHTML = `
            ${tag}
            <button type="button" class="remove-tag" data-index="${index}">
                ×
            </button>
        `;
        tagsDisplay.appendChild(tagEl);
    });
    
    tagsInput.value = tags.join(',');
}

function addTag() {
    const tagInput = document.getElementById('tagInput');
    const tag = tagInput.value.trim().toLowerCase();
    
    if (tag && !tags.includes(tag)) {
        tags.push(tag);
        tagInput.value = '';
        renderTags();
    }
}

document.getElementById('tagInput').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
        e.preventDefault();
        addTag();
    }
});

document.getElementById('addTagBtn').addEventListener('click', function(e) {
    e.preventDefault();
    addTag();
});

document.getElementById('tagsDisplay').addEventListener('click', function(e) {
    if (e.target.classList.contains('remove-tag')) {
        e.preventDefault();
        const index = parseInt(e.target.getAttribute('data-index'));
        tags.splice(index, 1);
        renderTags();
    }
});

const existingTags = '{{data.art.tags}}';
if (existingTags && existingTags.length > 0) {
    const tagsArray = existingTags.split(',').filter(t => t.trim());
    if (tagsArray.length > 0) {
        tags = tagsArray.map(t => t.trim());
        renderTags();
    }
}

document.getElementById('coverPhoto').addEventListener('change', function(e) {
    const file = e.target.files[0];
    const fileError = document.getElementById('fileError');
    const fileSuccess = document.getElementById('fileSuccess');
    const errorMsg = document.getElementById('errorMsg');
    const successMsg = document.getElementById('successMsg');
    const maxSize = 5 * 1024 * 1024;
    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
    
    fileError.style.display = 'none';
    fileSuccess.style.display = 'none';
    
    if (!file) return;
    
    if (!allowedTypes.includes(file.type)) {
        errorMsg.textContent = 'Invalid file type. Only JPG, PNG, and GIF are allowed.';
        fileError.style.display = 'block';
        e.target.value = '';
        return;
    }
    
    if (file.size > maxSize) {
        const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
        errorMsg.textContent = `File is too large (${sizeMB}MB). Maximum size is 5MB.`;
        fileError.style.display = 'block';
        e.target.value = '';
        return;
    }
    
    const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
    successMsg.textContent = `${file.name} (${sizeMB}MB) - Ready to upload`;
    fileSuccess.style.display = 'block';
});

const modal = document.getElementById('addCategoryModal');
const openBtn = document.getElementById('openAddCategoryBtn');
const closeBtn = document.getElementById('closeModalBtn');
const cancelBtn = document.getElementById('cancelModalBtn');
const submitBtn = document.getElementById('submitCategoryBtn');
const categoryInput = document.getElementById('newCategoryInput');
const categoryError = document.getElementById('categoryError');
const categorySuccess = document.getElementById('categorySuccess');
const errorText = document.getElementById('errorText');
const successText = document.getElementById('successText');
const categorySelect = document.getElementById('categorySelect');

function openModal() {
    modal.style.display = 'flex';
    categoryInput.focus();
}

function closeModal() {
    modal.style.display = 'none';
    categoryInput.value = '';
    categoryError.style.display = 'none';
    categorySuccess.style.display = 'none';
}

function resetMessages() {
    categoryError.style.display = 'none';
    categorySuccess.style.display = 'none';
}

async function addCategory() {
    const categoryName = categoryInput.value.trim();
    
    if (!categoryName) {
        errorText.textContent = 'Please enter a category name';
        categoryError.style.display = 'block';
        return;
    }
    
    resetMessages();
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 0.3rem;"></i>Adding...';
    
    try {
        const response = await fetch('/catagories/add-quick', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({catName: categoryName})
        });
        
        const data = await response.json();
        
        if (data.success) {
            successText.textContent = `"${categoryName}" added successfully!`;
            categorySuccess.style.display = 'block';
            
            const newOption = document.createElement('option');
            newOption.value = data.category._id;
            newOption.textContent = data.category.catName;
            categorySelect.appendChild(newOption);
            categorySelect.value = data.category._id;
            
            setTimeout(() => {
                closeModal();
            }, 1500);
        } else {
            errorText.textContent = data.message || 'Error adding category';
            categoryError.style.display = 'block';
        }
    } catch(err) {
        console.error('Error:', err);
        errorText.textContent = 'Error adding category. Please try again.';
        categoryError.style.display = 'block';
    } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fas fa-plus" style="margin-right: 0.3rem;"></i>Add Category';
    }
}

openBtn.addEventListener('click', function(e) {
    e.preventDefault();
    openModal();
});

closeBtn.addEventListener('click', closeModal);
cancelBtn.addEventListener('click', closeModal);

submitBtn.addEventListener('click', addCategory);

categoryInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
        e.preventDefault();
        addCategory();
    }
});

modal.addEventListener('click', function(e) {
    if (e.target === modal) {
        closeModal();
    }
});
</script>
