<div class="container my-articles-page">
    <div class="my-articles-header">
        <h1>
            <i class="fas fa-file-alt" style="margin-right: 0.8rem; color: var(--secondary-color);"></i>My Articles
        </h1>
        <p class="my-articles-subtitle">Manage and view all your published articles</p>
    </div>

    {{#if data.myArticles.length}}
    <div class="my-articles-grid">
        {{#each data.myArticles}}
        <article class="article-card my-article-card">
            <div class="article-card-image">
                {{#if coverPhoto}}
                <img src="/uploads/{{coverPhoto}}" alt="{{heading}}" style="width: 100%; height: 100%; object-fit: cover;">
                {{else}}
                <i class="fas fa-image"></i>
                {{/if}}
            </div>
            <div class="article-card-body">
                <div class="card-top-meta">
                    <span class="article-category">{{#if categoryID}}{{categoryID.catName}}{{else}}Uncategorized{{/if}}</span>
                </div>
                <h5 class="article-card-title">{{heading}}</h5>
                
                {{#if tags}}
                <div class="article-tags">
                    {{#each tags}}
                    <span class="article-tag">{{this}}</span>
                    {{/each}}
                </div>
                {{/if}}

                <div class="card-author-date">
                    <span class="author-date" style="color: #95a5a6; font-size: 0.8rem;">
                        <i class="fas fa-calendar-alt" style="font-size: 0.7rem; margin-right: 0.25rem;"></i>
                        {{#formatDate createdAt}}{{/formatDate}}
                    </span>
                </div>

                <div class="article-card-footer">
                    <!--<div class="article-stats-full">
                        <span class="stat-item-full">
                            <i class="fas fa-heart" style="color: var(--accent-color);"></i>
                            <span>{{likes}}</span>
                        </span>
                        <span class="stat-item-full">
                            <i class="fas fa-comment"></i>
                            <span>{{commentCount}}</span>
                        </span>
                    </div>-->
                    <div class="article-actions">
                        <a href="/comments?id={{_id}}" class="action-btn action-btn-view">
                            <i class="fas fa-eye"></i>
                            <span>View</span>
                        </a>
                        <a href="/articles/form?id={{_id}}" class="action-btn action-btn-edit">
                            <i class="fas fa-edit"></i>
                            <span>Edit</span>
                        </a>
                        <a href="/articles/delete?id={{_id}}" class="action-btn action-btn-delete" onclick="return confirm('Are you sure you want to delete this article?')">
                            <i class="fas fa-trash-alt"></i>
                            <span>Delete</span>
                        </a>
                    </div>
                </div>
            </div>
        </article>
        {{/each}}
    </div>
    {{else}}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-feather-alt"></i>
        </div>
        <h2>No Articles Yet</h2>
        <p>You haven't written any articles yet. Start creating your first article to share your thoughts with the community!</p>
        <a href="/articles/form" class="btn btn-primary">
            <i class="fas fa-pen" style="margin-right: 0.5rem;"></i>Write Your First Article
        </a>
    </div>
    {{/if}}
</div>

<style>
.my-articles-page {
    padding: 3rem 1rem;
    max-width: 1400px;
    margin: 80px auto 0;
    min-height: 100vh;
}

.my-articles-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--secondary-color);
}

.my-articles-header h1 {
    font-size: 2.8rem;
    color: var(--primary-color);
    font-weight: 700;
    margin: 0 0 0.8rem 0;
    font-family: 'Playfair Display', serif;
}

.my-articles-subtitle {
    color: #7f8c8d;
    font-size: 1.05rem;
    margin: 0;
    font-weight: 500;
}

.my-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
}

.my-article-card {
    position: relative;
}

.my-article-card .article-card-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.my-article-card .article-stats-full {
    flex: 1;
}

.article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
}

.article-tag {
    display: inline-block;
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.15) 0%, rgba(52, 152, 219, 0.08) 100%);
    color: var(--secondary-color);
    padding: 0.3rem 0.8rem;
    border-radius: 16px;
    font-size: 0.7rem;
    font-weight: 600;
    border: 1px solid rgba(52, 152, 219, 0.25);
}

.article-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
}

.action-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.8rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 1px solid transparent;
}

.action-btn i {
    font-size: 0.85rem;
}

.action-btn-view {
    background: linear-gradient(135deg, rgba(39, 174, 96, 0.1) 0%, rgba(39, 174, 96, 0.05) 100%);
    color: #27ae60;
    border-color: rgba(39, 174, 96, 0.2);
}

.action-btn-view:hover {
    background: linear-gradient(135deg, rgba(39, 174, 96, 0.15) 0%, rgba(39, 174, 96, 0.08) 100%);
    color: #229954;
    transform: translateY(-2px);
}

.action-btn-edit {
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.1) 0%, rgba(52, 152, 219, 0.05) 100%);
    color: var(--secondary-color);
    border-color: rgba(52, 152, 219, 0.2);
}

.action-btn-edit:hover {
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.15) 0%, rgba(52, 152, 219, 0.08) 100%);
    color: #2980b9;
    transform: translateY(-2px);
}

.action-btn-delete {
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.1) 0%, rgba(231, 76, 60, 0.05) 100%);
    color: #e74c3c;
    border-color: rgba(231, 76, 60, 0.2);
}

.action-btn-delete:hover {
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.15) 0%, rgba(231, 76, 60, 0.08) 100%);
    color: #c0392b;
    transform: translateY(-2px);
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.05);
}

.empty-state-icon {
    font-size: 4.5rem;
    color: var(--secondary-color);
    margin-bottom: 1.5rem;
    opacity: 0.8;
}

.empty-state h2 {
    font-size: 1.9rem;
    color: var(--primary-color);
    margin: 0 0 0.8rem 0;
    font-weight: 700;
}

.empty-state p {
    color: #7f8c8d;
    font-size: 1rem;
    margin: 0 0 2.5rem 0;
    line-height: 1.7;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
}

.empty-state .btn {
    display: inline-block;
}

@media (max-width: 1024px) {
    .my-articles-grid {
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.5rem;
    }
}

@media (max-width: 768px) {
    .my-articles-page {
        padding: 2rem 1rem;
    }

    .my-articles-header {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
    }

    .my-articles-header h1 {
        font-size: 2rem;
    }

    .my-articles-subtitle {
        font-size: 0.95rem;
    }

    .my-articles-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .article-card-image {
        height: 180px;
    }

    .action-btn span {
        display: none;
    }

    .action-btn {
        padding: 0.5rem;
        width: 36px;
        height: 36px;
        justify-content: center;
    }
}

@media (max-width: 576px) {
    .my-articles-page {
        padding: 1.5rem 0.75rem;
    }

    .my-articles-header h1 {
        font-size: 1.6rem;
    }

    .my-articles-subtitle {
        font-size: 0.9rem;
    }

    .my-articles-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .article-card-image {
        height: 160px;
    }

    .empty-state {
        padding: 2rem 1.5rem;
    }

    .empty-state-icon {
        font-size: 3.5rem;
    }

    .empty-state h2 {
        font-size: 1.4rem;
    }

    .empty-state p {
        font-size: 0.95rem;
    }

    .action-btn {
        padding: 0.4rem 0.6rem;
        font-size: 0.75rem;
    }

    .action-btn i {
        font-size: 0.75rem;
    }
}
</style>
